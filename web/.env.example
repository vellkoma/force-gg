# バックエンドAPIのベースURL（開発環境）
VITE_API_URL=http://localhost:8000

# Google AdSense（Phase 2以降 - サイト審査通過後に設定）
# VITE_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxxx

# OAuth 認証（Phase 4以降 - バックエンドでも同じ値を設定すること）
VITE_GOOGLE_CLIENT_ID=your_google_client_id
VITE_DISCORD_CLIENT_ID=your_discord_client_id
VITE_AUTH_REDIRECT_URL=http://localhost:5173/oauth/callback

# Stripe（フロントエンド用公開キー - テスト環境）
# https://dashboard.stripe.com/test/apikeys の「公開可能キー」
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
