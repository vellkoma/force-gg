RIOT_API_KEY=RGAPI-your-key-here
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:5173
ENV=development
LOG_LEVEL=INFO

# ----------------------------------------------------------------
# JWT / 認証
# ----------------------------------------------------------------
# 本番環境では必ずランダムな長い文字列に変更すること
# 生成例: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-secret-key-in-production
JWT_ALGORITHM=HS256

# ----------------------------------------------------------------
# Google OAuth 2.0
# https://console.cloud.google.com/ でOAuth 2.0クライアントIDを作成
# 承認済みリダイレクトURIに GOOGLE_REDIRECT_URI を追加すること
# ----------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173/oauth/callback

# ----------------------------------------------------------------
# Discord OAuth 2.0
# https://discord.com/developers/applications でアプリを作成
# OAuth2 > Redirects に DISCORD_REDIRECT_URI を追加すること
# ----------------------------------------------------------------
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:5173/oauth/callback

# ----------------------------------------------------------------
# Stripe 課金
# https://dashboard.stripe.com/test/apikeys でキーを取得
# Webhook: https://dashboard.stripe.com/test/webhooks
#   エンドポイント: https://your-domain/api/stripe/webhook
#   購読イベント: checkout.session.completed,
#                customer.subscription.deleted,
#                invoice.payment_failed
# ローカル転送: stripe listen --forward-to localhost:8000/api/stripe/webhook
# ----------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_MONTHLY_PRICE_ID=price_monthly_id_here
STRIPE_YEARLY_PRICE_ID=price_yearly_id_here

# フロントエンドURL（Stripe リダイレクト先として使用）
FRONTEND_URL=http://localhost:5173

# ----------------------------------------------------------------
# Anthropic (Claude API) — AI コーチング機能（Phase 5）
# https://console.anthropic.com/settings/keys でAPIキーを取得
# 未設定の場合はモックレスポンスを返す（サービス起動には不要）
# ----------------------------------------------------------------
ANTHROPIC_API_KEY=
